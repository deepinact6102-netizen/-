+  function ocrStatusText(result) {
+    if (result.fallback) {
+      return '品目名を読み取れなかったため、上から順に当てはめました。行がずれている場合があるので、全ての行を確認してください';
+    }
+    if (result.matched === 0) return '数字を認識できませんでした。手動で入力してください';
+    const rest = result.total - result.matched;
+    return rest > 0
+      ? `${result.total}品目中${result.matched}品目を読み取りました。残り${rest}品目は空欄です。手で入力してください`
+      : `${result.total}品目中${result.matched}品目を読み取りました。数字を確認して「この内容で入力」をタップしてください`;
+  }
+
+  // 全角・空白・絵文字を落として突き合わせやすくする
+  function normalizeOCRLine(s) {
+    return String(s == null ? '' : s).normalize('NFKC').replace(/[^\p{L}\p{N}]/gu, '');
+  }
+
+  function editDistance(a, b) {
+    const dp = [];
+    for (let j = 0; j <= b.length; j++) dp[j] = j;
+    for (let i = 1; i <= a.length; i++) {
+      let prev = dp[0];
+      dp[0] = i;
+      for (let j = 1; j <= b.length; j++) {
+        const cur = dp[j];
+        dp[j] = Math.min(dp[j] + 1, dp[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
+        prev = cur;
+      }
+    }
+    return dp[b.length];
+  }
+
+  // 品目名が行のどこに写っているかを返す。score 2=そのまま一致 / 1=1文字までの誤認識
+  function findName(name, line) {
+    if (!name || !line) return null;
