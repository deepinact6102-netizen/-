   // ---- アクセスコード ゲート ----
   const ACCESS_STORAGE_KEY = 'yakitori_access_code';
+  const ACCESS_VERIFIED_AT_KEY = 'yakitori_access_verified_at';
+  // サーバーに確認できない状態でも使える猶予期間（7日）
+  const OFFLINE_GRACE_MS = 7 * 24 * 60 * 60 * 1000;
+
+  function markVerified() {
+    localStorage.setItem(ACCESS_VERIFIED_AT_KEY, String(Date.now()));
+  }
+
+  // コードと確認時刻がずれないよう、消すときは必ず両方まとめて消す
+  function clearAccess() {
+    localStorage.removeItem(ACCESS_STORAGE_KEY);
+    localStorage.removeItem(ACCESS_VERIFIED_AT_KEY);
+  }
+
+  function isWithinOfflineGrace() {
+    const raw = localStorage.getItem(ACCESS_VERIFIED_AT_KEY);
+    if (!raw) return false;
+    const verifiedAt = Number(raw);
+    if (!Number.isFinite(verifiedAt) || verifiedAt <= 0) return false;
+    const elapsed = Date.now() - verifiedAt;
+    if (elapsed < 0) return false; // 端末の時計が進められている
+    return elapsed <= OFFLINE_GRACE_MS;
+  }
 
