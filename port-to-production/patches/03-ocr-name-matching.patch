+  function ocrStatusText(result) {
+    if (result.fallback) {
+      return '品目名を読み取れなかったため、上から順に当てはめました。行がずれている場合があるので、全ての行を確認してください';
+    }
+    if (result.matched === 0) return '数字を認識できませんでした。手動で入力してください';
+    const rest = result.total - result.matched;
+    return rest > 0
+      ? `${result.total}品目中${result.matched}品目を読み取りました。残り${rest}品目は空欄です。手で入力してください`
+      : `${result.total}品目中${result.matched}品目を読み取りました。数字を確認して「この内容で入力」をタップしてください`;
+  }
+
+  // 全角・空白・絵文字を落として突き合わせやすくする
+  function normalizeOCRLine(s) {
+    return String(s == null ? '' : s).normalize('NFKC').replace(/[^\p{L}\p{N}]/gu, '');
+  }
+
+  function editDistance(a, b) {
+    const dp = [];
+    for (let j = 0; j <= b.length; j++) dp[j] = j;
+    for (let i = 1; i <= a.length; i++) {
+      let prev = dp[0];
+      dp[0] = i;
+      for (let j = 1; j <= b.length; j++) {
+        const cur = dp[j];
+        dp[j] = Math.min(dp[j] + 1, dp[j - 1] + 1, prev + (a[i - 1] === b[j - 1] ? 0 : 1));
+        prev = cur;
+      }
+    }
+    return dp[b.length];
+  }
+
+  // 品目名が行のどこに写っているかを返す。score 2=そのまま一致 / 1=1文字までの誤認識
+  function findName(name, line) {
+    if (!name || !line) return null;
+    const i = line.indexOf(name);
+    if (i !== -1) return { score: 2, end: i + name.length };
+    // 2文字以下の名前は他の品目に紛れ込みやすいので曖昧一致させない
+    if (name.length < 3) return null;
+    const lens = [name.length, name.length - 1, name.length + 1];
+    for (const len of lens) {
+      if (len < 1) continue;
+      for (let s = 0; s + len <= line.length; s++) {
+        const w = line.slice(s, s + len);
+        if (/\d/.test(w)) continue;  // 記入された数字を名前の一部と取り違えない
+        if (editDistance(name, w) <= 1) return { score: 1, end: s + len };
+      }
+    }
+    return null;
+  }
+
+  // 名前より後ろにある数字を拾う（用紙は名前の右が記入欄）
+  function pickNumber(line, from) {
+    const m = line.slice(from).match(/\d+/);
+    if (!m) return null;
+    const n = parseInt(m[0], 10);
+    return n <= 9999 ? n : null;
+  }
+
+  // 品目名を手がかりに残数を読む。名前が見つからない品目は空欄のまま（行ずれを起こさない）
+  function readSheet(text) {
+    const lines = String(text == null ? '' : text).split('\n').map(normalizeOCRLine);
+    const targets = [];
+    items.forEach((it, idx) => {
+      const name = normalizeOCRLine(it.name);
+      if (name) targets.push({ idx, name });
+    });
+
+    const cands = [];
+    targets.forEach(t => {
+      lines.forEach((line, li) => {
+        const hit = findName(t.name, line);
+        if (hit) cands.push({ idx: t.idx, li, score: hit.score, end: hit.end, len: t.name.length });
+      });
+    });
+    // 確かな一致から、長い名前を優先して割り当てる（「むね」が「とりむね」の行を取らないように）
+    cands.sort((a, b) => b.score - a.score || b.len - a.len);
+
+    const isNameLine = lines.map((line, li) => cands.some(c => c.li === li));
+    const values = items.map(() => null);
+    const doneItem = items.map(() => false);
+    const doneLine = lines.map(() => false);
+    let matched = 0;
+
+    cands.forEach(c => {
+      if (doneItem[c.idx] || doneLine[c.li]) return;
+      // 同じ行を同じ確からしさで複数の品目が取り合うときは、取り違えを避けて捨てる
+      const rival = cands.some(o => o.li === c.li && o.idx !== c.idx && o.score === c.score && o.len === c.len && !doneItem[o.idx]);
+      if (rival) { doneLine[c.li] = true; return; }
+      doneItem[c.idx] = true;
+      doneLine[c.li] = true;
+      let n = pickNumber(lines[c.li], c.end);
+      if (n === null) {
+        // 数字が次の行に落ちることがあるので、数字だけの行なら拾う
+        for (let j = c.li + 1; j < lines.length; j++) {
+          if (!lines[j]) continue;
+          if (doneLine[j] || isNameLine[j]) break;
+          if (/\d/.test(lines[j]) && lines[j].replace(/\d/g, '').length <= 1) {
+            n = pickNumber(lines[j], 0);
+            if (n !== null) doneLine[j] = true;
+          }
+          break;
+        }
+      }
+      if (n !== null) { values[c.idx] = n; matched++; }
+    });
+
+    if (matched === 0) {
+      // 品目名が1つも読めなかった時だけ、従来どおり上から順に当てはめる
+      const nums = extractNumbers(text);
+      if (nums.length > 0) {
+        nums.forEach((n, i) => { values[i] = n; });
+        return { values, matched: 0, total: targets.length, fallback: true };
+      }
+    }
+    return { values, matched, total: targets.length, fallback: false };
+  }
